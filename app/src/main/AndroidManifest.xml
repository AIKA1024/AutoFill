<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:description="@string/app_desc"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            接收短信进程发来的显式广播，用 root 执行 input text 注入验证码。
            exported=true：短信进程（com.android.phone）需要跨进程调用它。
            显式广播（setPackage）在 Android 8+ 仍可唤醒静态注册的接收器，因此 App
            未运行时也能被拉起执行注入。
        -->
        <receiver
            android:name=".RootFillReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.autofill.sms.ROOT_FILL" />
            </intent-filter>
        </receiver>

        <!--
            短信进程通过显式绑定拉起本进程并执行 root 注入。
            exported=true：调用方是 com.android.phone（另一个 uid）。
            绑定是"显式启动组件"，不受 stopped state 限制，所以本应用即使一次都没
            打开过也能被拉起来注入；广播那条路（上面的 receiver）作为兜底保留。
        -->
        <service
            android:name=".RootFillService"
            android:exported="true" />

    </application>

</manifest>
