<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status"
            android:padding="12dp"
            android:text="正在连接框架…"
            android:textColor="#FF222222"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="行为"
            android:textColor="#FF4C8BF5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sw_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="启用模块（总开关）"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_auto_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="自动复制验证码"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_copy_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="复制整条短信（关闭则只复制验证码）"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_auto_fill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="自动填入文本框"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_toast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="显示 Toast"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="显示通知"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="拦截验证码短信（不再进短信库）"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="识别规则"
            android:textColor="#FF4C8BF5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="正则表达式（含捕获组时取第 1 组）"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_regex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="(?&lt;![0-9])[0-9]{4,8}(?![0-9])"
            android:inputType="textNoSuggestions"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_regex_reset"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恢复默认正则" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="关键词（逗号分隔，命中才认定为验证码短信；留空=不过滤）"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_keywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_keywords_reset"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恢复默认关键词" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="排除的应用包名（逗号分隔，这些应用不复制/不填入）"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_blacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.example.app1, com.example.app2"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="规则测试"
            android:textColor="#FF4C8BF5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="粘贴一条短信正文，例如：您的验证码是 884219，5 分钟内有效。"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="3"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_test"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试提取" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="使用说明：\n1. 在 LSPosed 中启用本模块，作用域勾选「系统框架」与「电话/Phone」，然后重启或软重启。\n2. 修改配置后需要重新打开一次本应用，或等待通知配置刷新；大部分情况下立即可用。\n3. 短信在 com.android.phone 进程解析，复制/Toast/通知/填入在前台 App 进程执行；若当时没有前台 App，则由电话进程兜底复制并通知。\n4. Android 13+ 上通知由前台 App 自己发出，若该 App 未授予通知权限，会自动改由电话进程代发。\n5. 拦截会在短信分发前丢弃该短信，请谨慎开启。"
            android:textColor="#FF666666"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
